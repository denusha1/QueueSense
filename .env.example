# Copy to .env, then set a local PostgreSQL owner password.
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
# All host ports default to loopback. To allow LAN access, change only HOST_BIND_ADDRESS.
HOST_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=3001
LOCAL_BIND_ADDRESS=127.0.0.1
API_PORT=8001
# Used only when running database/scripts/manage.py directly:
DATABASE_URL=postgresql://queuesense:REPLACE_ME@127.0.0.1:5432/queuesense
# Put a separate, URL-encoded password in this runtime connection URI.
# Compose provisioning creates this restricted local role and applies its grants.
AUTH_DATABASE_URL=postgresql://queuesense_auth:REPLACE_ME@db:5432/queuesense
# Bounds for application database connections and individual SQL operations.
DB_POOL_MAX_SIZE=0
# Disable per-request JSON logging when running a repeatable benchmark.
REQUEST_LOGS_ENABLED=true
# Optional private Prometheus bearer value. Generate 32 or more random characters.
METRICS_BEARER_TOKEN=
DB_CONNECT_TIMEOUT_SECONDS=5
DB_STATEMENT_TIMEOUT_MS=20000
DB_LOCK_TIMEOUT_MS=5000
# Production requires a deployment-specific signing secret from a secret manager.
# Generate 32 or more random bytes and encode as URL-safe Base64.
JWT_SIGNING_SECRET=
JWT_ISSUER=queuesense-staff
JWT_AUDIENCE=queuesense-private-api
JWT_ACCESS_TTL_SECONDS=600
JWT_REFRESH_TTL_SECONDS=28800
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8001
FRONTEND_ORIGINS=http://127.0.0.1:3001,http://localhost:3001
ENABLE_DEMO_LOGIN=false
# Frontend server-only backend address for native runs. Compose overrides this with its private api service.
AUTH_API_URL=http://127.0.0.1:8001
# Background in-app reminders, waiting updates and congestion warnings.
ENABLE_AUTOMATION=true
# Stable Fernet key for account MFA secrets and opted-in notification destinations.
# Required in production; generate privately and keep the same key across deployments.
ACCOUNT_ENCRYPTION_KEY=
# Optional SMTP email/recovery adapter (TLS required).
SMTP_HOST=
SMTP_PORT=587
SMTP_SSL=false
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
# Optional Twilio SMS adapter.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Optional Web Push; public/private VAPID pair and mailto: or HTTPS subject.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Extra trusted push hosts, comma-separated, only if your browser provider requires them.
PUSH_ALLOWED_HOSTS=


# Choreo origin integration is disabled with all five settings empty.
CHOREO_JWKS_URL=
CHOREO_ASSERTION_ISSUER=
CHOREO_ASSERTION_AUDIENCE=
CHOREO_ASSERTION_CONTEXT=
CHOREO_DEPARTMENT_ID=
