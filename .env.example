# Copy to .env, then set a local password (URL-safe letters/digits recommended).
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
# Used only when running database/scripts/manage.py directly:
DATABASE_URL=postgresql://queuesense:REPLACE_ME@127.0.0.1:5432/queuesense
# FastAPI runtime; use a restricted PostgreSQL role, not the database owner.
AUTH_DATABASE_URL=postgresql://queuesense_auth:REPLACE_ME@db:5432/queuesense
APP_ENV=development
FRONTEND_ORIGINS=http://127.0.0.1:3001,http://localhost:3001
ENABLE_DEMO_LOGIN=false
# Frontend server-only backend address; set in frontend/.env.local if changed.
AUTH_API_URL=http://127.0.0.1:8001
