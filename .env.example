# Copy to .env, then set a local password (URL-safe letters/digits recommended).
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
# Only the Next.js web port is public/LAN-facing. Keep DB and API host ports private.
HOST_BIND_ADDRESS=0.0.0.0
FRONTEND_PORT=3001
LOCAL_BIND_ADDRESS=127.0.0.1
API_PORT=8001
# Used only when running database/scripts/manage.py directly:
DATABASE_URL=postgresql://queuesense:REPLACE_ME@127.0.0.1:5432/queuesense
# FastAPI runtime; use a restricted PostgreSQL role, not the database owner.
AUTH_DATABASE_URL=postgresql://queuesense_auth:REPLACE_ME@db:5432/queuesense
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8001
FRONTEND_ORIGINS=http://127.0.0.1:3001,http://localhost:3001
ENABLE_DEMO_LOGIN=false
# Frontend server-only backend address for native runs. Compose overrides this with its private api service.
AUTH_API_URL=http://127.0.0.1:8001
# Background in-app reminders, waiting updates and congestion warnings.
ENABLE_AUTOMATION=true
# Stable Fernet key for account MFA secrets and opted-in notification destinations.
# Required in production; generate privately and keep the same key across deployments.
ACCOUNT_ENCRYPTION_KEY=
# Optional SMTP email/recovery adapter (TLS required).
SMTP_HOST=
SMTP_PORT=587
SMTP_SSL=false
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
# Optional Twilio SMS adapter.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Optional Web Push; public/private VAPID pair and mailto: or HTTPS subject.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Extra trusted push hosts, comma-separated, only if your browser provider requires them.
PUSH_ALLOWED_HOSTS=
